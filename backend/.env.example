# GitHub repository used as the only content store.
GITHUB_OWNER=NachoOsella
GITHUB_REPOSITORY=portfolio
GITHUB_TOKEN=github_pat_replace_me
GITHUB_BRANCH=main
GITHUB_CONTENT_ROOT=frontend/content

# The frontend origin allowed to send credentialed API requests.
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_SESSION_TTL=PT12H

# Comma-separated entries: email|bcryptHash|displayName
# Keep this value quoted when sourcing the file because bcrypt hashes contain '$'.
APP_AUTH_USERS='ignacio@example.com|$2a$12$replace-with-a-real-bcrypt-hash|Ignacio Osella'
