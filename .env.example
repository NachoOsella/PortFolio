# Dokploy production environment
# Copy these variables into Dokploy > Environment.
# Do not commit a real .env file or real secrets.

# Public URL configured in Dokploy for the web service.
APP_CORS_ALLOWED_ORIGIN=https://portfolio.example.com

# Production authentication settings.
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_SESSION_TTL=PT12H
# Format: email|bcryptHash|displayName
# Replace the hash with a real bcrypt hash. Keep $ characters unchanged.
APP_AUTH_USERS=ignacio@example.com|$2a$12$replace-with-a-real-bcrypt-hash|Ignacio Osella

# Optional GitHub backup used by Studio > Git.
# Leave GITHUB_TOKEN empty if you do not need remote backups.
GITHUB_OWNER=NachoOsella
GITHUB_REPOSITORY=portfolio
GITHUB_BRANCH=main
GITHUB_CONTENT_ROOT=frontend/content
GITHUB_TOKEN=github_pat_replace_me

# These values are already configured in docker-compose.dokploy.yml.
# CONTENT_ROOT=/app/content
# VITE_API_URL=/api
# SITE_ADDRESS=:8080
