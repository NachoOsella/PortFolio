{$SITE_ADDRESS} {
    encode gzip

    handle /api/* {
        reverse_proxy backend:8080
    }

    @assets path /assets/*
    handle @assets {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
